# Repo-local paths only. This intentionally does not activate Conda for you:
# run `conda activate carla_env` explicitly so the selected Python is visible.
export CARLA_RL_ROOT="$PWD"
export CARLA_ROOT="${CARLA_ROOT:-$HOME/git/carla}"
export CARLA_RUNS_ROOT="$CARLA_RL_ROOT/runs"
export CARLA_SERVER_CATALOG="$CARLA_RL_ROOT/configs/servers.json"
export PYTHONPATH="$CARLA_RL_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
PATH_add "$CARLA_RL_ROOT/scripts"
